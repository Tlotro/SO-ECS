            <ui:Button text="Main Menu" name="MainMenuButton" class="menu-button" style="left: auto; right: auto; align-self: center; justify-content: flex-start; position: absolute; -unity-font-style: bold; background-image: url(&quot;project://database/Assets/Sprites/UI/ButtonPressed.png?fileID=2800000&amp;guid=b4b2b5b1cca68924a9206ac6cc209d76&amp;type=3#ButtonPressed&quot;); -unity-slice-type: tiled; -unity-slice-left: 32; -unity-slice-right: 32; -unity-slice-top: 0; -unity-slice-bottom: 0; top: auto; height: 38px; -unity-slice-scale: 2px; background-color: rgba(0, 0, 0, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgb(255, 255, 255); font-size: 20px; -unity-text-outline-width: 0; text-shadow: 3px 3px 0 rgb(0, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); -unity-font-definition: url(&quot;project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&amp;guid=2014127f278120c49b33355e7baabe45&amp;type=3#NotInter-Regular&quot;); bottom: 20px;"/>
