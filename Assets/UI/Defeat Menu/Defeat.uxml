    <ui:VisualElement name="Menu" enabled="true" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.784); visibility: visible;">
        <ui:VisualElement name="Panel" style="flex-grow: 0; flex-shrink: 0; position: absolute; width: 200px; height: 140px; align-self: center; top: 100px; background-image: url(&quot;project://database/Assets/Sprites/UI/Pause.png?fileID=2800000&amp;guid=a34ae773d4b2ca64d91c2023a57abe57&amp;type=3#Pause&quot;); -unity-slice-type: tiled; -unity-slice-left: 16; -unity-slice-top: 16; -unity-slice-right: 16; -unity-slice-bottom: 16;">
            <ui:Label text="Game Over" name="Title" style="align-self: center; top: 10px; font-size: 25px; position: absolute; color: rgb(255, 255, 255); -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(0, 0, 0); text-shadow: 2px 1px 0 rgb(0, 0, 0);"/>
