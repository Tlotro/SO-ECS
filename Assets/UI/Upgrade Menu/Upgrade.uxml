        <ui:VisualElement name="Panel" style="flex-grow: 0; flex-shrink: 0; position: absolute; width: 400px; height: 300px; align-self: center; top: 26px; background-image: url(&quot;project://database/Assets/Sprites/UI/Upgrade.png?fileID=2800000&amp;guid=8b0bd73caab103943b3d21b7e77acc6d&amp;type=3#Upgrade&quot;); -unity-slice-type: tiled; -unity-slice-left: 16; -unity-slice-top: 16; -unity-slice-right: 16; -unity-slice-bottom: 16; left: 120px;">
